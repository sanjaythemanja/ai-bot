# Copy to .env and fill in.

# local (default) or production. Production refuses to start with unsafe
# settings: no DATABASE_URL, DEMO_MODE on, non-https BASE_URL, weak APP_SECRET.
APP_ENV=local
PORT=8080
# BASE_URL=http://localhost:8080
TIMEZONE=Asia/Kolkata
DATA_DIR=data

# true = sample Gmail/Calendar data instead of your real account.
DEMO_MODE=false

# ---------------- AI model (any provider) ----------------
# LLM_PROVIDER: openai (any OpenAI-compatible API) | anthropic
# Left empty, it is inferred from the key (sk-ant-… → anthropic, else openai).
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Optional: point at any OpenAI-compatible server.
#   OpenAI (default)  https://api.openai.com/v1
#   OpenRouter        https://openrouter.ai/api/v1
#   Groq              https://api.groq.com/openai/v1
#   Google Gemini     https://generativelanguage.googleapis.com/v1beta/openai   (model e.g. gemini-3.8-flash)
#   Ollama (local)    http://localhost:11434/v1   (no key needed)
# LLM_BASE_URL=
#
# OPENAI_API_KEY or ANTHROPIC_API_KEY also work if LLM_API_KEY is empty.

# ---------------- External agents ----------------
# If set, /api/tools requires "Authorization: Bearer <token>".
AGENT_API_TOKEN=

# ---------------- Google ----------------
# OAuth client (Web application) from Google Cloud Console.
# Authorized redirect URI: http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ---------------- Conversation history ----------------
# PostgreSQL from docker-compose.yml (make db-up). Empty = in-memory only.
DATABASE_URL=postgres://assistant:assistant@localhost:5432/assistant?sslmode=disable

# ---------------- Sign-in & users ----------------
# Encrypts each user's Google token in the database. Required (unless DEMO_MODE).
# Generate with: openssl rand -base64 48
APP_SECRET=
# Who may sign in: comma-separated emails and/or @yourcompany.com. Empty = anyone
# Google lets through (in OAuth "Testing" mode, only the test users you add).
ALLOWED_EMAILS=
# How long a sign-in lasts (Go duration).
SESSION_TTL=720h
# Optional: let /api/tools act as this user when called with AGENT_API_TOKEN.
AGENT_USER_EMAIL=

# ---------------- Production hardening ----------------
# Chat/briefing requests allowed per user per minute (small burst allowed).
CHAT_PER_MINUTE=12
# Log full tool inputs (can include email text). Keep false in production.
LOG_TOOL_INPUTS=false
# Protects /metrics with "Authorization: Bearer <token>". Empty = local-only.
METRICS_TOKEN=
# Public URL of the app; https:// turns on Secure cookies and HSTS.
# BASE_URL=https://your-app.example.com
